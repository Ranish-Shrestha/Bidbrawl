# Local Secret Bid requires no environment variables.
# Configure these server-side for hosted online rooms. Never use VITE_ prefixes.
DATABASE_URL=
ONLINE_ORIGIN=
ONLINE_SESSION_PEPPER=
# Optional realtime. Set all four to enable private Pusher connections.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Optional authenticated cleanup endpoint.
CRON_SECRET=
