{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/setup", "destination": "/index.html" },
    { "source": "/live", "destination": "/index.html" },
    { "source": "/replay", "destination": "/index.html" },
    { "source": "/online", "destination": "/index.html" },
    { "source": "/match", "destination": "/index.html" },
    { "source": "/results", "destination": "/index.html" }
  ]
}
